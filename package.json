{
  "name": "report-flow",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.4.1",
      "typescript": "^6.0.3"
    },
    "catalogs": {
      "web": {
        "@elysia/bearer": "^1.4.4",
        "@elysia/cors": "^1.4.2",
        "@elysia/openapi": "^1.4.16",
        "@elysia/server-timing": "^1.4.1",
        "@elysiajs/html": "^1.4.2",
        "elysia": "^1.4.30"
      },
      "db": {
        "drizzle-orm": "^1.0.0-rc.5-ab785fc",
        "drizzle-kit": "^1.0.0-rc.5-ab785fc"
      },
      "utils": {
        "@types/luxon": "^3.7.5",
        "luxon": "^3.7.2",
        "varlock": "^1.21.0",
        "zod": "^4.6.5",
        "logixlysia": "^6.9.3"
      }
    }
  },
  "scripts": {
    "build": "bun run --filter './apps/**' build",
