{
	"compilerOptions": {
		/* Language and Environment */
		"target": "ES2021",

		/* Modules */
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"paths": {
			"~/*": ["./*"],
			"@/*": ["./src/*"],
		},

		/* Interop Constraints */
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,

		/* Type Checking */
		"strict": true,

		/* Completeness */
		"skipLibCheck": true,
	},
}
